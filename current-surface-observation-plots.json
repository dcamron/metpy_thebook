:{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"nWGJROP6F0"}],"key":"Fah0KJYTmG"}],"key":"At39y5ebrQ"}],"key":"o9kScYTAMG"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"These three elements are separate parts of the declarative module from MetPy. In Python we call these parts\nClasses and note that they contain MiXeD case names. These classes contain a number of attributes that can\nbe set to specify what and how to plot the data in a figure. The descriptions of some of the basic\nelements of each element are given below.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"wK28eyALUg"}],"key":"It6GzonLy4"}],"key":"ESYfRsyL3u"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import Modules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CYb6KhohHy"}],"identifier":"import-modules","label":"Import Modules","html_id":"import-modules","implicit":true,"key":"EUAyy1Dgtw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we’ll import those modules that are needed to produce read in remote surface METAR observation data, process those observations, and plot the values on a map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"buH0hhhM7y"}],"key":"Pwgs2hrFIM"}],"key":"kudIvMLWa3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime, timedelta, UTC\nfrom io import StringIO\nfrom urllib.request import urlopen\n\nfrom metpy.io import metar\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport pandas as pd","key":"l0UjaXgAsq"},{"type":"outputs","id":"yIr7BkV7h9QH7h7nH8oLr","children":[],"key":"Mc8JexjbVz"}],"key":"RFLv8TDQt6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F2f6WAAhAm"}],"identifier":"read-data","label":"Read Data","html_id":"read-data","implicit":true,"key":"lzlu6GIBXu"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The surface data are in METAR format and store the data files at this location for approximately two weeks.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"a0igY8G45g"}],"key":"xqImUclUoG"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The format of the filenames are ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"PQaqbmxYaX"},{"type":"inlineCode","value":"YYYYMMDDHH_sao.wmo","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CawkWktsB1"},{"type":"text","value":" where ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"QgWY3OsGUH"},{"type":"inlineCode","value":"YYYY","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"m6MN6qPQnh"},{"type":"text","value":" is the year, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"NXJULi2tbo"},{"type":"inlineCode","value":"MM","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ILzXB1nnYK"},{"type":"text","value":" is the month, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"aU49HRtTe0"},{"type":"inlineCode","value":"DD","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"dQKKCYUuLf"},{"type":"text","value":" is the day, and ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"aWKxNto7G9"},{"type":"inlineCode","value":"HH","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"mwxRwfwfGi"},{"type":"text","value":" is the hour.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"IxU1bcW3iu"}],"key":"Un3B63Yvi3"}],"key":"dKoDdpZm0z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Get the current date/time and remove the timezone information\ndate = datetime.now(UTC).replace(tzinfo=None)\n\n# Remote Access - Archive Data Read with pandas from Iowa State Archive,\n# note differences from METAR files\ndt = timedelta(minutes=30)\nsdate = date - dt\nedate = date + dt\ndata_url = ('http://mesonet.agron.iastate.edu/cgi-bin/request/asos.py?'\n            'data=all&tz=Etc/UTC&format=comma&latlon=yes&'\n            f'year1={sdate.year}&month1={sdate.month}&day1={sdate.day}'\n            f'&hour1={sdate.hour}&minute1={sdate.minute}&'\n            f'year2={edate.year}&month2={edate.month}&day2={edate.day}'\n            f'&hour2={edate.hour}&minute2={edate.minute}')\ndata = pd.read_csv(data_url, skiprows=5, na_values=['M'],\n                   low_memory=False).replace('T', 0.00001).groupby('station').tail(1)\ndf = metar.parse_metar_file(StringIO('\\n'.join(val for val in data.metar)),\n                            year=date.year, month=date.month)\n# Local Access\n# data = f'/data/ldmdata/surface/sao/{date:%Y%m%d%H}_sao.wmo'\n# df = metar.parse_metar_file(data, year=date.year, month=date.month)","key":"HpztryMgTx"},{"type":"outputs","id":"rAkA8UB_fGyawovUUC1zF","children":[],"key":"BXCFrTKGnq"}],"key":"VwesERvkIt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GjT1Mq2ztU"}],"identifier":"plot-data","label":"Plot Data","html_id":"plot-data","implicit":true,"key":"jPX6LqJSDO"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we seek to use the data that were just read in to plot the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PovV47ovxA"},{"type":"inlineCode","value":"air_temperature","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"x63H2RnB1C"},{"type":"text","value":" variable in units of Fahrenheit. Since surface observations can be associated with a range of times, we can set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EIpzVel6JP"},{"type":"inlineCode","value":"time_window","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dpEKPqjPzP"},{"type":"text","value":" attribute to look over a range of times. These temperatures will be plotted on a map over a small geographic location and a title is added to the map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RsIBPv6AoU"}],"key":"Pb4DMPTfNH"}],"key":"HpqSAv8DCZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot desired data\nobs = declarative.PlotObs()\nobs.data = df\nobs.time = date\nobs.time_window = timedelta(minutes=30)\nobs.fields = ['air_temperature']\nobs.plot_units = ['degF']\n\n# Panel for plot with Map features\npanel = declarative.MapPanel()\npanel.layout = (1, 1, 1)\npanel.projection = 'lcc'\npanel.area = 'in'\npanel.layers = ['states']\npanel.title = f'Air temperature on {date:%Y%m%d} at {date:%H}UTC'\npanel.plots = [obs]\n\n# Bringing it all together\npc = declarative.PanelContainer()\npc.size = (10, 10)\npc.panels = [panel]\n\npc.show()","key":"M5oID3FbnB"},{"type":"outputs","id":"PVJsBTlkShU0A9dVl-y2q","children":[],"key":"nxV74NXe2d"}],"key":"istPYcUVIM"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"gRxUAez51B"}],"key":"DmawaPjbEI"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The use of formatted strings (f-strings) are used extensively in this book. Use of these strings allows the easy input of variables into a string value to dynamically generate the string. Variables can also be formatted (depending on type) to gain more control over how the values plot. In the above surface plot, f-strings are used to set the title where we use the variable ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"gUP9Pfasaj"},{"type":"inlineCode","value":"date","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mEqiARbItD"},{"type":"text","value":" with date formatting to make a nice, reable title.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"PTpB7FJ6Tq"}],"key":"pFYLwHVEZY"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For more information on f-strings, see the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ghQIvkpHVq"},{"type":"link","url":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","children":[{"type":"text","value":"Python documentation","key":"LzwqmNVv8X"}],"urlSource":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","key":"HFvI7vYelZ"}],"key":"arcUmdgJsX"}],"key":"anb12meejE"}],"key":"eLHcXryM79"}],"key":"To9YSbWcLL"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Common Notebook Structure","url":"/typical-notebook-structure","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Practice Tasks - Surface Observation","url":"/practice-tasks-surface","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://pre.render"}